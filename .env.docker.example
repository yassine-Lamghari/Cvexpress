# Supabase/PostgreSQL (public browser values, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Server-only key used by the background worker to update job metadata.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Server-side application secrets
GEMINI_API_KEY=

# MinIO administrator account (console only)
MINIO_ROOT_USER=cvzzer-root
MINIO_ROOT_PASSWORD=replace-with-a-long-random-root-password

# MinIO account used by the CVzzer server
MINIO_APP_ACCESS_KEY=cvzzer-app
MINIO_APP_SECRET_KEY=replace-with-a-long-random-application-secret
MINIO_REGION=us-east-1

# Durable asynchronous PDF queue
REDIS_PASSWORD=replace-with-a-long-random-redis-password
PDF_WORKER_CONCURRENCY=2
TASK_API_SECRET=replace-with-a-long-random-internal-api-secret

# Optional email configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CVzzer

# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
